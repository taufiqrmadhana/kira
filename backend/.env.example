# Copy to backend/.env for local use. Leave the password empty only for local use.
OPENAI_API_KEY=
KIRA_MODEL=openai/gpt-6.1-terra
# Alternative: KIRA_MODEL=deepseek/deepseek-chat and set DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
KIRA_DATABASE_URL=sqlite:///kira.db
KIRA_USER=Taufiq
KIRA_AI=on
KIRA_USERNAME=kira
KIRA_PASSWORD=
KIRA_SECRET=
KIRA_CLIENT_NAME=Main workspace
